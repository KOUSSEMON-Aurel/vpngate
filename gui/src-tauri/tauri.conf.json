{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vpngate",
  "version": "0.1.0",
  "identifier": "net.vpngate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vpngate",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/vpngate"],
    "icon": ["icons/icon.png"]
  }
}