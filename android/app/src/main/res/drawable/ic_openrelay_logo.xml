<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cyber Shield Background Surface -->
    <path
        android:pathData="M54,12 L86,24 C86,54 74,78 54,94 C34,78 22,54 22,24 Z"
        android:strokeWidth="1.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="12"
                android:endY="94"
                android:startColor="#0F172A"
                android:endColor="#060C18"
                android:type="linear" />
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="24"
                android:endX="86"
                android:endY="94"
                android:startColor="#1E293B"
                android:centerColor="#059669"
                android:endColor="#1E293B"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Subtle Center Grid Axis -->
    <path
        android:pathData="M54,16 L54,90"
        android:strokeWidth="1"
        android:strokeAlpha="0.3"
        android:strokeColor="#1E293B" />
    <path
        android:pathData="M26,54 L82,54"
        android:strokeWidth="1"
        android:strokeAlpha="0.3"
        android:strokeColor="#1E293B" />

    <!-- Inter-Letter Relay Bridge connecting O and R -->
    <path
        android:pathData="M48,54 L58,54"
        android:strokeWidth="6.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="48"
                android:startY="54"
                android:endX="58"
                android:endY="54"
                android:startColor="#059669"
                android:endColor="#00F0FF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- LETTER O: High-Precision Cyber Ring -->
    <path
        android:pathData="M36,38 A16,16 0 1,0 36,70 A16,16 0 1,0 36,38 Z"
        android:strokeWidth="7">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="38"
                android:endX="52"
                android:endY="70"
                android:startColor="#00F5A0"
                android:endColor="#059669"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Target Inner Rings in O -->
    <path
        android:pathData="M36,46.5 A7.5,7.5 0 1,0 36,61.5 A7.5,7.5 0 1,0 36,46.5 Z"
        android:strokeWidth="1.8"
        android:strokeAlpha="0.4"
        android:strokeColor="#00F5A0" />
    <path
        android:pathData="M36,54 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
        android:fillColor="#00F5A0" />
    <path
        android:pathData="M36,54 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:fillColor="#FFFFFF" />

    <!-- LETTER R: Full Vertical Spine -->
    <path
        android:pathData="M58,36 L58,72"
        android:strokeWidth="7"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="58"
                android:startY="36"
                android:endX="84"
                android:endY="72"
                android:startColor="#00F0FF"
                android:endColor="#2563EB"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- LETTER R: Upper Bowl -->
    <path
        android:pathData="M58,36 L73,36 C81,36 85,40 85,46.5 C85,53 81,55 73,55 L58,55"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="58"
                android:startY="36"
                android:endX="84"
                android:endY="72"
                android:startColor="#00F0FF"
                android:endColor="#2563EB"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- LETTER R: Forward Relay Leg -->
    <path
        android:pathData="M67,54 L84,72"
        android:strokeWidth="7"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="58"
                android:startY="36"
                android:endX="84"
                android:endY="72"
                android:startColor="#00F0FF"
                android:endColor="#2563EB"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Signal Sparkles -->
    <path
        android:pathData="M58,36 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M84,72 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#00F0FF" />
    <path
        android:pathData="M36,38 m-1.8,0 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0"
        android:fillColor="#A7F3D0" />

</vector>
